   "name": "basic, sorted by label, Papirus first",
   "lang": "C",
   "dirs": [
    {
     "themes": {
      "Yaru": {
       "index": "[Icon Theme]\nName=Yaru\nDirectories=48x48/apps\n",
       "subdirs": [
        "48x48/apps"
       ]
      },
      "breeze": {
       "index": "[Icon Theme]\nName=Breeze\nDirectories=48x48/apps\n",
       "subdirs": [
        "48x48/apps"
       ]
      },
      "Adwaita": {
       "index": "[Icon Theme]\nName=Adwaita\nDirectories=48x48/apps\n",
       "subdirs": [
        "48x48/apps"
       ]
      },
      "Papirus-Dark": {
       "index": "[Icon Theme]\nName=Papirus-Dark\nDirectories=48x48/apps\n",
       "subdirs": [
        "48x48/apps"
       ]
      }
     }
    }
   ],
   "expected": [
    [
     "Papirus",
     "Papirus"
    ],
    [
     "Adwaita",
     "Adwaita"
    ],
    [
     "breeze",
     "Breeze"
    ],
    [
     "Yaru",
     "Yaru"
    ]
   ]
  },
