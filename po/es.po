#: home/.local/bin/sway-desktop-config
msgid ""
"usage: sway-desktop-config get <key>   shows a value, for the Bash scripts\n"
"       sway-desktop-config generate      writes the files that depend on the color\n"
"       sway-desktop-config apply         writes the files and reloads Sway\n"
"       sway-desktop-config css           shows the accent colors as GTK CSS (@define-color)\n"
"       sway-desktop-config enabled NAME  exits 0 if the component is on in [enabled], 1 if not\n"
"       sway-desktop-config waybar [FILE] writes the Waybar config without the modules turned off\n"
"       sway-desktop-config keys          writes config.d/00-keys.conf, the includes of the shortcut profile"
msgstr ""
"uso: sway-desktop-config get <key>   muestra un valor, para los scripts de Bash\n"
"     sway-desktop-config generate      escribe los archivos que dependen del color\n"
"     sway-desktop-config apply         escribe los archivos y recarga Sway\n"
"     sway-desktop-config css           muestra los colores de acento como CSS de GTK (@define-color)\n"
"     sway-desktop-config enabled NAME  sale con 0 si el componente está activado en [enabled], 1 si no\n"
"     sway-desktop-config waybar [FILE] escribe la configuración de Waybar sin los módulos desactivados\n"
"     sway-desktop-config keys          escribe config.d/00-keys.conf, los include del perfil de atajos"

