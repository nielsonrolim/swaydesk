// swaydesk-calendar: the clock, with the calendar on click, for your own Waybar. More: https://swaydesk.nielsonrolim.com/en-us/components/calendar/
// In ~/.config/waybar/config.jsonc, add "custom/swaydesk-calendar" to "modules-left", "modules-center" or
// "modules-right", and paste the lines below next to your other modules (a comma between them).
// The icons are Nerd Font symbols (Symbols Nerd Font, in swaydesk-common).
  "custom/swaydesk-calendar": {
    "exec": "exec ~/.local/bin/waybar-clock",
    "return-type": "json",
    "restart-interval": 5,
    "on-click": "~/.local/bin/waybar-calendar"
  }
