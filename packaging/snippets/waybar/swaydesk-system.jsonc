// swaydesk-system: CPU, memory and temperature, with the process popup, for your own Waybar. More: https://swaydesk.org/en-us/components/system/
// In ~/.config/waybar/config.jsonc, add "custom/swaydesk-system" to "modules-left", "modules-center" or
// "modules-right", and paste the lines below next to your other modules (a comma between them).
// The icons are Nerd Font symbols (Symbols Nerd Font, in swaydesk-common).
  "custom/swaydesk-system": {
    "exec": "exec ~/.local/bin/waybar-system",
    "return-type": "json",
    "restart-interval": 5,
    "on-click": "~/.local/bin/waybar-system-popup",
    "on-click-right": "~/.local/bin/waybar-system-popup --monitor"
  }
