// swaydesk-bluetooth: the Bluetooth icon and its popup (BlueZ), for your own Waybar. More: https://swaydesk.nielsonrolim.com/en-us/components/bluetooth/
// In ~/.config/waybar/config.jsonc, add "custom/swaydesk-bluetooth" to "modules-left", "modules-center" or
// "modules-right", and paste the lines below next to your other modules (a comma between them).
// The icons are Nerd Font symbols (Symbols Nerd Font, in swaydesk-common).
  "custom/swaydesk-bluetooth": {
    "exec": "exec ~/.local/bin/waybar-bluetooth",
    "return-type": "json",
    "restart-interval": 5,
    "on-click": "~/.local/bin/waybar-bluetooth-popup"
  }
