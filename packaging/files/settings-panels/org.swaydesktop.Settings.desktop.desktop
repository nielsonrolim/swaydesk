Categories=GTK;Settings;DesktopSettings;
OnlyShowIn=sway;
Keywords=components;shortcuts;bar;dock;settings;
Keywords[pt_BR]=componentes;atalhos;barra;dock;configurações;
Keywords[es]=componentes;atajos;barra;dock;configuración;
