# Swaydesk: the app grid, resident and hidden until shown.
# For a session other than Swaydesk's (plain Sway, niri, Hyprland with uwsm...); the package doesn't enable
# it. With graphical-session.target (niri, uwsm): systemctl --user enable --now swaydesk-drawer. Plain Sway never
# reaches that target: the component's snippet starts the unit and stops it when Sway exits,
# /usr/share/swaydesk/sway/config.d/50-swaydesk-drawer.conf. It never starts inside the Swaydesk session, whose
# Sway config runs the component itself (SWAYDESK_SESSION: sway-session sets it, sway-env-cleanup unsets it)
[Unit]
Description=Swaydesk: the app grid, resident and hidden until shown
Documentation=man:swaydesk-drawer(1)
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=!SWAYDESK_SESSION
# A Wayland that went away (the compositor quit without stopping the unit): a few tries, then it stops
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
ExecStart=/usr/bin/swaydesk-drawer start
# Always, as the session's respawn loops do: the theme tool restarts the dock and the OSD with pkill (SIGTERM,
# a clean exit). systemctl --user stop still stops it
Restart=always
RestartSec=1
# 3: the grid is off ([enabled] app_grid = false); 4: another copy holds the lock (one from an exec line of
# the Sway config, say), so no restart beside it
RestartPreventExitStatus=3 4
# ...and it isn't a failure: the unit ends inactive, with the other copy running
SuccessExitStatus=4
# Only the component on stop and restart. The apps it opens go into their own app-swaydesk-*.scope
# (swaydesk_common::app_scope); process: an app the scope move missed (a launcher's early fork) stays alive
# instead of being killed, and only "left-over process" is logged. Its helpers (the swaymsg of the Sway events)
# die with it (setpriv --pdeathsig); the default control-group mode would SIGTERM them at the same time, and
# their EOF could reach the component first and end it with an error (failed on a plain stop)
KillMode=process

[Install]
WantedBy=graphical-session.target
