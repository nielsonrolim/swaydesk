#!/bin/sh
# O CSS de GTK 4 do adw-gtk3 (gtk-4.0/libadwaita.css) é o mesmo nas duas variantes: as cores escuras ficam só em
# blocos de uma linha `@media (prefers-color-scheme: dark) { ... }`, que o GTK antes do 4.20 (o 4.18 do Debian 13)
# pula ("Unknown @ rule"). Sem isto, os apps GTK 4 sem libadwaita (o pavucontrol 6, por exemplo) ficavam claros com
# o adw-gtk3-dark. Aqui, no arquivo da variante escura, esses blocos perdem o @media e valem sempre; o GTK 4.20 em
# diante dá o mesmo resultado. O resto (o prefers-contrast) fica como está.
# Para se o arquivo tiver outra forma (um @media em várias linhas, um prefers-color-scheme: light) ou nenhum bloco
# escuro: o pacote sairia claro de novo sem aviso.
set -eu
css=$1
query='@media (prefers-color-scheme: dark) {'
if ! grep -qF "$query" "$css"; then
  echo "dark-gtk4: no '$query' block in $css" >&2
  exit 1
fi
sed -i 's/^@media (prefers-color-scheme: dark) { \(.*\) }$/\1/' "$css"
if grep -n 'prefers-color-scheme' "$css" >&2; then
  echo "dark-gtk4: prefers-color-scheme left in $css (lines above): the upstream CSS changed its form" >&2
  exit 1
fi
