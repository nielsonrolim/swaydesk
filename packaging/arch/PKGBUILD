# Os componentes em Rust + GTK 4, divididos como no debian/ (packaging/components.list). Ainda não
# publicado no AUR: a fonte é o tarball da tag no GitHub, que só existe quando o repositório abrir.
# Para testar sem a tag, ponha ao lado deste arquivo o swaydesk-<versão>.tar.gz feito com
#   git archive --prefix=sway-desktop-<versão>/ -o packaging/arch/swaydesk-<versão>.tar.gz HEAD
# e rode o makepkg com --skipchecksums.
# Maintainer: Nielson Rolim <nielsonrolim@users.noreply.github.com>
pkgbase=swaydesk
pkgname=(swaydesk-common swaydesk-notifd swaydesk-dock swaydesk-drawer swaydesk-calendar swaydesk-weather
        swaydesk-audio swaydesk-network swaydesk-bluetooth swaydesk-battery swaydesk-brightness
        swaydesk-caffeine swaydesk-system swaydesk-media swaydesk-clipboard swaydesk-osd swaydesk-language
        swaydesk-switcher swaydesk-help swaydesk-click-catcher swaydesk-capture swaydesk-theme-tool
        swaydesk-portal swaydesk-theme-app swaydesk-displays swaydesk-session-menu swaydesk-lock
        swaydesk-keyring swaydesk-sessionmgr swaydesk-desktop swaydesk-greeter swaydesk-widgets swaydesk-theme
        swaydesk-session swaydesk-bar swaydesk-apps swaydesk-scripts)
pkgver=0.1.7
pkgrel=1
pkgdesc="Sway desktop components in Rust and GTK 4 for wlroots compositors with layer-shell"
arch=(x86_64 aarch64)
url="https://swaydesk.nielsonrolim.com"
# Os binários ligam os crates de terceiros: as licenças deles (as do debian/copyright, que o
# tests/test_packaging.py confere). Os pacotes sem binário (arch=any) ficam só com a MIT
license=(MIT Apache-2.0 'Apache-2.0 WITH LLVM-exception' BSD-3-Clause CC0-1.0 CDLA-Permissive-2.0 GPL-3.0-only ISC
         Unicode-3.0 Unlicense Zlib)
makedepends=(cargo gtk4 gtk4-layer-shell pkgconf python)
# O LTO do makepkg compila o C do ring (o TLS do tempo e das capas) com -flto, e o linker do Rust não junta
# esses objetos: undefined symbol ring_core_*. O workspace já usa o LTO do próprio Rust (profile.release)
options=(!lto)
source=("$pkgbase-$pkgver.tar.gz::https://github.com/nielsonrolim/sway-desktop/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')  # na publicação: o sha256 do tarball da tag
_src=sway-desktop-$pkgver

prepare() {
  cd "$_src/rust"
  # O tarball do packaging/make-orig.sh (o do OBS, que compila sem rede) já traz os crates em vendor/
  [[ -d vendor ]] && return
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_src/rust"
  # shellcheck disable=SC2046 # os -p separados
  cargo build --frozen --release $(../packaging/install-tree.sh --crates)
}

check() {
  cd "$_src/rust"
  cargo test --frozen --release
}

_install() {
  cd "$srcdir/$_src"
  # No Arch, os programas internos de um pacote ficam em /usr/lib/<pacote>
  SWAYDESK_LIBEXEC=/usr/lib packaging/install-tree.sh "$1" "$pkgdir" "$PWD/rust/target/release"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$1/LICENSE"
  # As licenças dos crates que os binários do pacote ligam, em crates/ (nada nos pacotes sem binário)
  (cd rust && python ../packaging/crate-licenses.py arch "$1" "$pkgdir/usr/share/licenses/$1")
}

package_swaydesk-common() {
  pkgdesc="Sway desktop components - shared data (translations)"
  arch=(any)
  # GPL-3.0-only: os ícones de Captura de Tela e Gravar Tela, cópias do Papirus (ver o debian/copyright)
  license=(MIT GPL-3.0-only)
  # A noto-fonts em primeiro: o pacman resolve as dependências em ordem, e o sway (da dock e do greeter) pede um
  # ttf-font. Com a noto-fonts já na transação, ele não pergunta o provedor (o padrão seria o gnu-free-fonts)
  # A ttf-nerd-fonts-symbols são os ícones; no Debian, a fonte vai dentro do pacote
  # O bash: os scripts em comum, que vieram do swaydesk-scripts. O libnotify: o aviso do session-action quando o
  # bloqueio de fora do Sway falha
  depends=(noto-fonts ttf-nerd-fonts-symbols bash)
  optdepends=('libnotify: session notices')
  SWAYDESK_BUNDLED_FONT=0 _install swaydesk-common
}

