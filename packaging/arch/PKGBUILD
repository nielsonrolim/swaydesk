package_swaydesk-lock() {
  pkgdesc="Sway desktop components - lock screen"
  # O bloqueio abre a libpam na hora e usa o serviço PAM próprio (/etc/pam.d/swaydesk-lock); o gtklock (extra)
  # é a reserva do sway-lock, no lugar do swaylock, que não tem teclas mortas
  depends=("swaydesk-common=$pkgver-$pkgrel" glib2 gtk4 gtk4-layer-shell pam gtklock systemd)
  optdepends=('swayidle: lock when idle' 'libnotify: the notice when the screen does not lock')
  backup=(etc/pam.d/swaydesk-lock)
  SWAYDESK_PYTHON_LOCK=0 _install swaydesk-lock
}

