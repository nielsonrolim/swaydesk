package_swaydesk-scripts() {
  pkgdesc="Sway desktop components - transitional, goes away in 0.2.0 (metapackage)"
  arch=(any)
  license=(MIT)
  # Até a 0.1.6, os scripts auxiliares; desde a 0.1.7, cada script vai no pacote que o chama (os de mais de um, no
  # swaydesk-common), e quem atualiza um componente já recebe os dele. Este fica só para a atualização: puxar os
  # pacotes que levaram os scripts daria a quem só tinha a grade o bloqueio, o calendário e a captura. Sai na 0.2.0
  depends=("swaydesk-common=$pkgver-$pkgrel")
  _install swaydesk-scripts
}
