  optdepends=('swaydesk-session-menu: ask before restarting or shutting down (without it, no confirmation)')
  _install swaydesk-sessionmgr
}


package_swaydesk-desktop() {
  pkgdesc="Sway desktop - the full session (Sway and Waybar configuration, session scripts, first-login setup)"
  # O cursor Bibata do config do Sway não está nos repositórios oficiais: o capitaine-cursors, o mais parecido,
  # é o que a sessão escolhe no lugar dele (swaydesk_common::cursor, no 00-cursor.conf e no dconf do GTK).
  # O pacman não tem Recommends nem instala os optdepends: tudo o que o Debian recomenda vai nos depends, para
  # o Arch ficar como uma instalação padrão do Debian (fora o python-holidays, que só existe no AUR). Os
  # serviços que o pacman não liga (Bluetooth, NetworkManager, perfis de energia) ficam no aviso do .install.
  # O power-profiles-daemon também é satisfeito pelo tlp-pd (provides), o caminho de quem usa o TLP. O
  # gnome-keyring guarda as senhas dos apps (navegador, git, NetworkManager); no Debian, ele e o PAM vêm com o
  # desktop ou pelo Recommends do swaydesk-greeter. O PAM de quem entra pelo greetd está no .install do greeter.
  # A exceção, por decisão do usuário: o editor de texto do botão Abrir da Ajuda (o 50-local.conf) fica nos
  # optdepends, porque sem ele a Ajuda abre o arquivo num editor do terminal (o $EDITOR, o nano ou o vi)
  arch=(any)
  license=(MIT)
  install=swaydesk-desktop.install
  # libqalculate: o qalc da calculadora da grade de apps. pacman-contrib: o checkupdates do aviso de atualizações
  # (sway-updates), porque a GNOME Software do Arch só avisa das do Flatpak. O fakeroot: o checkupdates sincroniza
  # a cópia dos bancos com ele, e o pacman-contrib só o lista nos optdepends (sem o base-devel, ele falha)
  # O paku (github.com/nielsonrolim/paku, do repositório do projeto no OBS, como estes pacotes): o pacman e um
  # helper do AUR, se houver, num comando só. Vai como ferramenta para o usuário (decisão do usuário, 0.1.4), e a
  # janela de atualização (sway-updates) o usa. Sem helper, ele roda o pacman com sudo. O >= é a versão com o
  # "maintain" que o sway-updates chama (a manutenção do arch-update, decisão do usuário, 0.1.4) e que, desde a 0.3.2,
  # depende ele mesmo do que o maintain usa: o archlinux-contrib (o checkservices do passo dos serviços) saiu daqui na
  # 0.1.7, porque nada do Swaydesk o chama. O pacman-contrib e o fakeroot ficam: o sway-updates chama o checkupdates.
  # O nome paku não é de nenhum pacote oficial, do AUR ou do
  # BlackArch (conferido em 22/11/2026: o BlackArch tem um "pacu", outro programa, e o pacman resolve um nome pelo
  # primeiro repositório do pacman.conf que o tem; o passo 4 do packaging/obs/README.md confere a cada versão)
  # O pipewire-jack em primeiro: a waybar e o ffmpeg (do wf-recorder) pedem um jack, e o pacman, que resolve em
  # ordem, perguntaria o provedor com o jack2 de padrão. O áudio da sessão é o PipeWire
  depends=(pipewire-jack "swaydesk-common=$pkgver-$pkgrel" swaydesk-notifd swaydesk-dock swaydesk-drawer swaydesk-calendar
           swaydesk-weather swaydesk-audio swaydesk-network swaydesk-bluetooth swaydesk-battery
           swaydesk-brightness swaydesk-caffeine swaydesk-system swaydesk-media swaydesk-clipboard swaydesk-osd
           swaydesk-language swaydesk-switcher swaydesk-help swaydesk-click-catcher swaydesk-capture
           swaydesk-theme-tool swaydesk-portal swaydesk-theme-app swaydesk-displays swaydesk-session-menu
           swaydesk-lock swaydesk-keyring swaydesk-sessionmgr
           sway swaybg swayidle waybar kitty rofi libqalculate jq curl
           wl-clipboard cliphist xdg-desktop-portal-wlr xdg-desktop-portal-gtk dconf glib2 noto-fonts noto-fonts-emoji gnome-themes-extra adw-gtk-theme systemd
           mate-polkit xorg-xwayland thunar blueman papirus-icon-theme grim slurp wf-recorder brightnessctl
           playerctl pavucontrol wireplumber libpulse networkmanager network-manager-applet bluez upower gammastep
           libnotify power-profiles-daemon xdg-user-dirs qt5ct qt6ct capitaine-cursors
           gnome-keyring pacman-contrib fakeroot 'paku>=0.3.2' kbd)
  # O fcitx5 só com o [enabled] input_method ligado (o ç no Chromium e no Electron): opcional, como no Suggests do
  # Debian; a ISO o instala e liga
  optdepends=("gnome-text-editor: the Help's Open button, for 50-local.conf"
              'nano: the same in the terminal, without a graphical editor'
              'fcitx5: dead keys and ç in Chromium and Electron apps, with input_method = true')
  # O portal do gtk por um drop-in na unit: o dbus-broker avisa de um segundo .service com o mesmo nome
  # O us-intl.map do console (o kbd, nos depends, tem o us-acentos que ele inclui)
  SWAYDESK_LIBEXEC=/usr/lib SWAYDESK_PORTAL_GTK=systemd SWAYDESK_CONSOLE_KEYMAPS=/usr/share/kbd/keymaps/xkb \
    _install swaydesk-desktop
  # A GNOME Software sem a parte de atualizações: o sway-updates avisa de tudo no Arch. O hook do glib2 compila
  install -Dm644 packaging/files/90_swaydesk-desktop.gschema.override \
    "$pkgdir/usr/share/glib-2.0/schemas/90_swaydesk-desktop.gschema.override"
}

package_swaydesk-greeter() {
  pkgdesc="Sway desktop - login screen for greetd (GTK 4, in the look of the lock screen)"
  # O pacman não liga serviços: o .install mostra o systemctl enable greetd
  install=swaydesk-greeter.install
  depends=("swaydesk-common=$pkgver-$pkgrel" gtk4 gtk4-layer-shell glib2 greetd sway)
  optdepends=('gnome-keyring: unlock the login keyring with the login password')
  # O serviço do PAM das sessões abertas pela tela: o /etc/pam.d/greetd do Arch não chama o gnome-keyring, e
  # o pacote não mexe nele. O greetd.toml do pacote aponta as sessões para este serviço e deixa a do greeter
  # no greetd; um arquivo editado à mão fica como .pacsave na remoção
  backup=(etc/pam.d/swaydesk-greeter)
  # O usuário e o VT do greetd do Arch: greeter e o tty1, não o tty7 do Debian. O greetd.service do Arch tem
  # Conflicts=getty@tty1.service, e um drop-in não apaga um Conflicts=. Num tty7, o Ctrl+Alt+F1 faria o logind
  # subir o autovt@tty1 (o mesmo getty@tty1), e o systemd pararia o greetd e a sessão aberta. No tty1, nada do
  # kernel nem do boot aparece por cima do greeter (VM archlinux, loglevel=3 quiet, 16/11/2026)
  SWAYDESK_GREETER_USER=greeter SWAYDESK_GREETER_VT=1 SWAYDESK_GREETER_PAM_STACK=arch _install swaydesk-greeter
}

