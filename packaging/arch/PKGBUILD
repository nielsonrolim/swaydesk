  pkgdesc="Sway desktop components - notification daemon, center and Waybar icon"
  depends=("swaydesk-common=$pkgver-$pkgrel" gtk4 gtk4-layer-shell)
  provides=(notification-daemon)
  _install swaydesk-notifd
}

