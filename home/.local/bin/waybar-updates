#!/usr/bin/env bash
# Ícone das atualizações do sistema na Waybar (custom/updates), só no Arch: a quantidade, e some com nenhuma. Lê
# o cache que o sway-updates grava (~/.cache/swaydesk/updates), sem rede e sem abrir processos, a cada 5 s, e
# só escreve quando muda; o sway-updates manda SIGUSR1 ao gravar. A dica mostra as primeiras 15 da lista.
set -uo pipefail
if [ -r "${0%/*}/sway-i18n.sh" ]; then . "${0%/*}/sway-i18n.sh"; else t() { printf '%s' "$1"; }
  tn() { if [ "$3" = 1 ]; then printf '%s' "$1"; else printf '%s' "$2"; fi; }; fi
self=$(readlink -f -- "$0")
source "${self%/*}/waybar-icon-lib"
list=${XDG_CACHE_HOME:-$HOME/.cache}/swaydesk/updates
SHOWN=15
# Os bytes em UTF-8: o $'\U…' do bash depende do locale e, no C (um Arch sem locale-gen), sai literal
ICON=$'\xf3\xb0\x9a\xb0'  # U+F06B0, nf-md-update
ARROW=$'\xe2\x86\x92'     # →
# Os textos, uma vez: o plural depende do número, então os dois lados ficam guardados
HEAD_ONE=$(tn '%d update available' '%d updates available' 1)
HEAD_MANY=$(tn '%d update available' '%d updates available' 2)
MORE_ONE=$(tn 'and %d more' 'and %d more' 1)
MORE_MANY=$(tn 'and %d more' 'and %d more' 2)
CLICK=$(t 'Click to update')

line=
build() {
  local items=() item n tip head more extra i
  [[ -r $list ]] && mapfile -t items <"$list" 2>/dev/null
  n=${#items[@]}
  if ((n == 0)); then
    line='{"text":"","tooltip":"","class":"none"}'
    return
  fi
  head=$HEAD_MANY more=$MORE_MANY
  ((n == 1)) && head=$HEAD_ONE
  tip=${head//%d/$n}
  for ((i = 0; i < n && i < SHOWN; i++)); do
    item=${items[i]}
    # O sway-updates só grava linhas "nome antiga -> nova" com letras, números e . : _ + ~ @ -: nada a escapar
    [[ $item =~ ^[A-Za-z0-9@._+-]+\ [A-Za-z0-9.:_+~-]+\ -\>\ [A-Za-z0-9.:_+~-]+$ ]] || continue
    tip+="\\n${item/ -> / $ARROW }"
  done
  extra=$((n - SHOWN))
  if ((extra > 0)); then
    ((extra == 1)) && more=$MORE_ONE
    tip+="\\n${more//%d/$extra}"
  fi
  tip+="\\n\\n$CLICK"
  printf -v line '{"text":"%s %d","tooltip":"%s","class":"available"}' "$ICON" "$n" "$tip"
}

icon_loop waybar-updates
