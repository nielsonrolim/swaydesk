/*
 * Sway Desktop: o lançador (sway-launcher), no Alt+Espaço.
 * Gerado pelo sway-desktop-config: edite o modelo em home/.local/share/sway-desktop/templates/
 *
 * O cartão dos popups: escuro nos dois estilos, cantos arredondados, o destaque na seleção.
 * Vale para o rofi 1.7 (Debian 13, pelo Xwayland) e o 2.0 (Wayland).
 */

* {
    bg:          #2e2e33f7;
    field:       #3a3a40;
    hover:       #3a3a40;
    border:      #ffffff10;
    fg:          #e8e8e8;
    dim:         #8a8a8f;
    accent:      #{{accent}};
    on-accent:   #{{on_accent}};

    background-color: transparent;
    text-color:       @fg;
    font:             "Noto Sans 11";
}

window {
    width:            640px;
    /* Preso pelo topo: a lista cresce para baixo e o cartão não pula enquanto se digita */
    location:         north;
    anchor:           north;
    y-offset:         20%;
    background-color: @bg;
    border:           1px;
    border-color:     @border;
    border-radius:    12px;
    padding:          14px;
}

mainbox {
    spacing:  12px;
    children: [ inputbar, message, listview, mode-switcher ];
}

/* O campo como os das outras buscas (a grade, o clipboard): #38383d, borda de 1 px e cantos de 8 px. O rofi não tem
 * estado de foco no tema, e o campo está sempre focado: a borda é a do destaque, como a dos outros com o foco */
inputbar {
    background-color: #38383d;
    border:           1px;
    border-color:     @accent;
    border-radius:    8px;
    padding:          10px 14px;
    spacing:          10px;
    /* A lupa no lugar do prompt, que mostraria o nome do modo (os botões embaixo já o mostram) */
    children:         [ textbox-search, entry ];
}

textbox-search {
    expand:         false;
    str:            ""; /* a lupa (nf-fa-search) */
    text-color:     @accent;
    font:           "Symbols Nerd Font 14";
    vertical-align: 0.5;
}

entry {
    font:              "Noto Sans 15";
    placeholder:       "Search…";
    placeholder-color: @dim;
    vertical-align:    0.5;
}

message {
    background-color: @field;
    border-radius:    10px;
    padding:          8px 12px;
}

listview {
    lines:        6;
    columns:      1;
    fixed-height: false;
    dynamic:      true;
    scrollbar:    false;
    spacing:      2px;
}

element {
    padding:       8px 10px;
    border-radius: 10px;
    spacing:       12px;
}

element normal.normal, element alternate.normal, element normal.active, element alternate.active {
    background-color: transparent;
    text-color:       @fg;
}

element selected.normal, element selected.active {
    background-color: @accent;
    text-color:       @on-accent;
}

element-icon {
    size:             32px;
    vertical-align:   0.5;
    background-color: transparent;
}

element-text {
    vertical-align: 0.5;
    text-color:     inherit;
}

mode-switcher {
    spacing: 6px;
}

/* Cada botão do tamanho do rótulo: iguais, os cinco cortariam o "Área de transferência" do pt_BR.
 * Os cantos como os do campo e dos itens */
button {
    expand:           false;
    padding:          6px 12px;
    border-radius:    10px;
    background-color: @field;
    text-color:       @dim;
    font:             "Noto Sans 9";
}

button selected {
    background-color: @accent;
    text-color:       @on-accent;
}
