[Desktop Entry]
Type=Application
Name=Displays
Name[pt_BR]=Telas
Name[es]=Pantallas
GenericName=Arrange screens, resolution and scale
GenericName[pt_BR]=Posição, resolução e escala das telas
GenericName[es]=Posición, resolución y escala de las pantallas
Comment=Arranges the screens and remembers the layout of each set of monitors
Comment[pt_BR]=Posiciona as telas e lembra o layout de cada conjunto de monitores
Comment[es]=Coloca las pantallas y recuerda la disposición de cada conjunto de monitores
Exec=sway-displays --settings-panel
TryExec=swaydesk-displays
Icon=preferences-desktop-display
Terminal=false
StartupNotify=false
Categories=GTK;Settings;HardwareSettings;
OnlyShowIn=sway;
Keywords=display;monitor;screen;resolution;scale;rotation;
Keywords[pt_BR]=tela;telas;monitor;display;resolução;escala;rotação;
Keywords[es]=pantalla;pantallas;monitor;display;resolución;escala;rotación;
