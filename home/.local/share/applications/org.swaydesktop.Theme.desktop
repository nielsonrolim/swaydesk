[Desktop Entry]
Type=Application
Name=Desktop Theme
Name[pt_BR]=Tema do Desktop
Name[es]=Tema del escritorio
GenericName=Change theme, icons and accent color
GenericName[pt_BR]=Trocar tema, ícones e cor de destaque
GenericName[es]=Cambiar el tema, los iconos y el color de acento
Comment=Chooses the GTK theme and applies it across the desktop
Comment[pt_BR]=Escolhe o tema GTK e aplica em todo o desktop
Comment[es]=Elige el tema GTK y lo aplica en todo el escritorio
Exec=sway-theme-app --settings-panel
Icon=org.swaydesktop.Theme
Terminal=false
StartupNotify=false
Categories=GTK;Settings;DesktopSettings;
OnlyShowIn=sway;Hyprland;river;niri;
Keywords=theme;color;accent;gtk;qt;
Keywords[pt_BR]=tema;theme;cor;color;accent;destaque;gtk;qt;
Keywords[es]=tema;theme;color;accent;acento;gtk;qt;
