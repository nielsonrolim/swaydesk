[Desktop Entry]
Type=Application
Name=Record Screen
Name[pt_BR]=Gravar Tela
Name[es]=Grabar pantalla
GenericName=Screen recording
GenericName[pt_BR]=Gravação de tela
GenericName[es]=Grabación de pantalla
Comment=Opens the recording panel; while recording, stops it (same as Super+Shift+R)
Comment[pt_BR]=Abre o painel de gravação; durante a gravação, para (igual a Super+Shift+R)
Comment[es]=Abre el panel de grabación; durante la grabación, la detiene (igual que Super+Shift+R)
Exec=sway-capture rec
Icon=swaydesk-screen-record
Terminal=false
StartupNotify=false
Categories=AudioVideo;Recorder;
Keywords=record;screencast;screen;video;
Keywords[pt_BR]=record;screencast;gravar;gravação;tela;video;
Keywords[es]=record;screencast;grabar;grabación;pantalla;video;vídeo;
# Só no Sway e nos compositores do app Tema: o painel e os helpers usam o Sway e o wlroots
OnlyShowIn=sway;Hyprland;river;niri;
